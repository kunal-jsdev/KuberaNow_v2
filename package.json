{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clearFetchCache.mjs && npm run generate:types && npm run generate:importmap",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "backfill:article-ids:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/backfillArticleIds.ts --dry-run",
    "backfill:article-ids": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/backfillArticleIds.ts",
    "backfill:version-article-ids:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/backfillVersionArticleIds.ts --dry-run",
    "backfill:version-article-ids": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/backfillVersionArticleIds.ts",
    "backfill:video-ids:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/backfillVideoIds.ts --dry-run",
    "backfill:video-ids": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/backfillVideoIds.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@gsap/react": "^2.1.2",
    "@lexical/react": "0.50.0",
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@mongodb-js/saslprep": "^1.4.13",
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-select": "^2.3.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/ejs": "^3.1.5",
    "@types/nodemailer": "^8.0.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "ejs": "^6.0.1",
    "formik": "^2.4.9",
    "framer-motion": "^12.42.2",
    "hls.js": "^1.7.3",
    "logrocket": "^12.1.1",
    "lottie-react": "^3.1.2",
    "mongodb": "6.20.0",
    "next": "16.3.3",
    "next-cloudinary": "^6.17.5",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.5",
    "payload": "3.90.2",
    "payload-storage-cloudinary": "^1.2.1",
    "postcss": "^8.5.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-select": "5.9.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "swiper": "^14.0.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tus-js-client": "^4.3.1",
    "yup": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aria-query": "^5.3.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^3.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^5",
    "typescript-eslint": "^8.61.1"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
